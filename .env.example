# Copy to .env.local for local development. On Vercel these are provisioned
# automatically: `vercel integration add neon` (DATABASE_URL) and
# `vercel blob create-store <name> --access public --yes` (BLOB_READ_WRITE_TOKEN),
# then `vercel env pull .env.local --yes`. See docs/OPERATIONS.md.

# Neon Postgres connection string.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Vercel Blob read/write token, for image uploads.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Signs session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Absolute site URL, used for sitemap/RSS/OG links. No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
